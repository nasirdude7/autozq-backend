# ================================================
# 服务器配置
# ================================================
PORT=3001
NODE_ENV=development

# ================================================
# 数据库配置（PostgreSQL）
# ================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autozq_sales
DB_USER=postgres
DB_PASSWORD=your_password_here

# ================================================
# AI API 密钥
# ================================================
# Claude API（Anthropic）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API（可选）
OPENAI_API_KEY=your_openai_api_key_here

# ================================================
# JWT 认证
# ================================================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ================================================
# 代理配置（可选）
# ================================================
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ================================================
# WhatsApp Business API（可选，后期对接）
# ================================================
# WHATSAPP_API_URL=https://graph.facebook.com/v17.0
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ================================================
# SalesMartly 集成配置
# ================================================
# SalesMartly AI 员工 AccessToken（从 SalesMartly AI 员工配置页面获取）
SALESMARTLY_ACCESS_TOKEN=your_access_token_here

# SalesMartly 消息回复 API 地址（官方固定地址，无需修改）
SALESMARTLY_REPLY_URL=https://msg.salesmartly.com/ai-employee/send-message

# Webhook 签名密钥（可选，用于验证 SalesMartly 推送的消息）
SALESMARTLY_WEBHOOK_SECRET=your_webhook_secret_here

# ================================================
# 邮件配置（可选）
# ================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# ================================================
# 文件上传配置
# ================================================
MAX_FILE_SIZE=10485760
# 10MB in bytes

# ================================================
# CORS 配置
# ================================================
CORS_ORIGIN=*
# 生产环境建议设置为具体域名，如：https://yourdomain.com

# ================================================
# 其他配置
# ================================================
# 日志级别
LOG_LEVEL=info

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# AI 翻译默认语言
DEFAULT_LANGUAGE=zh
