# ============================================================
# AutoZQ 后端环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================

# ---------- 运行环境 ----------
# 生产部署务必设为 production：
#   - 启用 CORS 白名单校验、错误信息脱敏
#   - 禁用本地翻墙代理（否则服务器上 AI 调用会失败）
NODE_ENV=production
PORT=3001

# ---------- 安全（生产必填/必改）----------
# JWT 签名密钥。必须改成足够随机的长字符串，不能用默认值。
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 允许访问 API 的前端域名白名单（逗号分隔，含协议，不带末尾斜杠）
# 例：https://autozq.ru,https://www.autozq.ru
CORS_ORIGIN=https://your-domain.com

# ---------- 数据库（PostgreSQL）----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=autozq
DB_USER=autozq
# 生产必须改成强密码，不能用默认的 postgres
DB_PASSWORD=CHANGE_ME_strong_password

# ---------- AI 服务 ----------
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------- SalesMartly Webhook 集成 ----------
# 接收/回复消息的访问令牌
SALESMARTLY_ACCESS_TOKEN=your_salesmartly_token
SALESMARTLY_REPLY_URL=https://msg.salesmartly.com/ai-employee/send-message
# HMAC 签名密钥：配置后 webhook 会校验签名，防止伪造消息注入。强烈建议配置。
SALESMARTLY_WEBHOOK_SECRET=your_webhook_secret
# AI 机器人 ID 和名称（从 SalesMartly 后台获取，回复消息时必需）
SALESMARTLY_ROBOT_ID=0
SALESMARTLY_ROBOT_NAME=AutoZQ AI
# AI 自动回复开关（默认关闭，需要时设为 true）
ENABLE_AUTO_REPLY=false

# ---------- 客户会员端（手机号+验证码登录）----------
# 客户端 JWT 有效期（复用 JWT_SECRET，但 token 带 type:customer 与员工隔离）
CUSTOMER_TOKEN_EXPIRES=30d
# 短信服务商（可插拔）：none=桩(不真发,开发环境回传验证码) | smsru=sms.ru | twilio=Twilio
# 生产接真实短信时改成 smsru 或 twilio，并填下面对应的密钥
SMS_PROVIDER=none
# sms.ru（SMS_PROVIDER=smsru 时必填）
SMSRU_API_ID=
# Twilio（SMS_PROVIDER=twilio 时必填）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- 代理（仅本地开发翻墙用）----------
# 生产环境请留空或删除；NODE_ENV=production 时代码也会自动跳过代理。
HTTP_PROXY=
HTTPS_PROXY=

# ---------- 其他 ----------
DEFAULT_LANGUAGE=zh
MAX_FILE_SIZE=10485760
SESSION_TIMEOUT=3600
LOG_LEVEL=info
